# ==================================================
# KawaiiBake - Environment Variables (template)
# Copy to .env and fill in real values. NEVER commit .env.
# ==================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_NAME=kawaiibake
DB_USER=kawaiibake
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Email ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@kawaiibake.local

# --- AI Assistant (Phase 7) ---
# mock (default, offline, no key) | openai
AI_PROVIDER=mock
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
# Point at an OpenAI-compatible local runtime (Ollama, vLLM) if desired.
AI_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Object Storage (future) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
